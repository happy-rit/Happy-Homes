					<p>
						<a href="tel:+917399182000">+91 73991 82000</a><a
							href="mailto:happyhomehotel@gmail.com">happyhomehotel@gmail.com</a>
					</p>
				</div>
			</div>
			<div class="footer-bottom">
				<span>© 2026 Happy Homes Hotel. All rights reserved.</span><span>Made
